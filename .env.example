# Docker Compose production settings. Copy to .env and replace every placeholder.
MONGO_ROOT_USERNAME=campus_admin
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-32-character-or-longer-random-secret
# The public browser origin. No trailing slash.
CLIENT_URL=https://parking.example.edu
# Same-origin defaults for the combined Docker container.
VITE_API_URL=/api
VITE_SOCKET_URL=
