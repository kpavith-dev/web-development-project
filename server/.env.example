PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/smart-campus-parking
# Never use MONGO_URI for destructive tests. Tests must run against the isolated test DB on port 27018.
MONGO_TEST_URI=mongodb://127.0.0.1:27018/smart-campus-parking-test
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Optional reverse proxy configuration. If running behind a reverse proxy (e.g. Nginx, Docker), set TRUST_PROXY=1 or TRUST_PROXY=loopback.
# Leave unset or false for direct connections to prevent X-Forwarded-For spoofing.
TRUST_PROXY=
# Browser-build variables. For the combined Docker deployment use /api and leave
# VITE_SOCKET_URL empty so Socket.IO uses the current origin.
VITE_API_URL=/api
VITE_SOCKET_URL=
# Optional SMTP settings, required to deliver password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
