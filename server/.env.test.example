# Template for isolated E2E testing environment variables.
# Never commit real credentials or actual secrets.
# Port 27018 and database name smart-campus-parking-test are strictly enforced.
NODE_ENV=test
PORT=5000
MONGO_TEST_URI=mongodb://127.0.0.1:27018/smart-campus-parking-test
JWT_SECRET=replace-with-a-dedicated-test-secret-at-least-32-chars
CLIENT_URL=http://localhost:5173

